# Copy this file to local.properties (gitignored) in this directory and fill in
# real values. Do not commit local.properties or real credentials.
#
# Base URL of the Capella App Services / Sync Gateway host, e.g. wss://example.cloud.couchbase.com:4984
CBL_BASE_URL=
# Name of the sync endpoint/database to connect to
CBL_ENDPOINT=
# Sync Gateway / App Services username
CBL_USER=
# Sync Gateway / App Services password
CBL_PASSWORD=
